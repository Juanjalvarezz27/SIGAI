generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Direcciones {
  id        Int       @id @default(autoincrement())
  direccion String
  pisoId    Int
  areas     Area[]
  piso      Piso      @relation(fields: [pisoId], references: [id])
  usuarios  Usuario[]
}

model Area {
  id          Int       @id @default(autoincrement())
  nombre      String
  direccionId Int
  direccion   Direcciones @relation(fields: [direccionId], references: [id])
  usuarios    Usuario[]
}

model Piso {
  id          Int           @id @default(autoincrement())
  piso        String
  direcciones Direcciones[]
}

model Usuario {
  id Int @id @default(autoincrement())
  cedula String?
  nombre String
  apellido String?
  email String? @unique
  rolId Int
  direccionId Int
  areaId Int?
  password String?
  estado String @default("Activo")
  tipoAnalistaId Int?
  supervisorTipoId Int? 

  equipos Equipos[]
  ticketCerrado Ticket[] @relation("TicketCerrado")
  ticketCreado Ticket[] @relation("TicketCreado")
  ticketAnalistaEquipo TicketEquipo[] @relation("EquiposAnalista")
  ticketAnalista TicketEvento[] @relation("EventosAnalista")
  area Area? @relation(fields: [areaId], references: [id])
  direccion Direcciones @relation(fields: [direccionId], references: [id])
  rol Rol @relation(fields: [rolId], references: [id])
  tipoAnalista TipoAnalista? @relation(fields: [tipoAnalistaId], references: [id])
  supervisorTipo SupervisorTipo? @relation(fields: [supervisorTipoId], references: [id]) // Nueva relación

  deshabilitacionesRealizadas DeshabilitacionHistorial[] @relation("DeshabilitacionesRealizadas")
  deshabilitacionesRecibidas DeshabilitacionHistorial[] @relation("DeshabilitacionesRecibidas")
  deshabilitacionesEquiposRealizadas DesincorporacionHistorialEquipos[] @relation("DeshabilitacionesEquiposRealizadas")
  
  reasignacionesAnterior TicketReasignacion[] @relation("ReasignacionAnterior")
  reasignacionesNueva    TicketReasignacion[] @relation("ReasignacionNueva")
  reasignacionesSupervisor TicketReasignacion[] @relation("ReasignacionSupervisor")

  reasignacionesEquipoAnterior ReasignacionHistorialEquipos[] @relation("ReasignacionEquipoAnterior")
  reasignacionesEquipoNueva ReasignacionHistorialEquipos[] @relation("ReasignacionEquipoNueva")
  reasignacionesEquipoRealizadas ReasignacionHistorialEquipos[] @relation("ReasignacionEquipoRealizada")

  ticketAfectado Ticket[] @relation("TicketAfectado")
  ticketCierre TicketCierre[]

  @@map("usuarios")
  TicketSistema TicketSistema[]
}
model TipoAnalista {
  id    Int       @id @default(autoincrement())
  tipo  String
  usuarios Usuario[]
  
  @@map("tipo_analista")
}
model SupervisorTipo {
  id Int @id @default(autoincrement())
  tipo String
  usuarios Usuario[]

  @@map("supervisor_tipo")
}

model TicketReasignacion {
  id Int @id @default(autoincrement())
  ticketId Int
  analistaAnteriorId Int
  analistaNuevoId Int
  supervisorId Int
  motivo String?
  fechaReasignacion DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  analistaAnterior Usuario @relation("ReasignacionAnterior", fields: [analistaAnteriorId], references: [id])
  analistaNuevo Usuario @relation("ReasignacionNueva", fields: [analistaNuevoId], references: [id])
  supervisor Usuario @relation("ReasignacionSupervisor", fields: [supervisorId], references: [id])

  @@map("ticket_reasignacion")
}

model DeshabilitacionHistorial {
  id                    Int       @id @default(autoincrement())
  usuarioId             Int
  motivo                String
  fechaDeshabilitacion  DateTime  @default(now())
  deshabilitadoPorId    Int
  usuario               Usuario   @relation("DeshabilitacionesRecibidas", fields: [usuarioId], references: [id])
  deshabilitadoPor      Usuario   @relation("DeshabilitacionesRealizadas", fields: [deshabilitadoPorId], references: [id])

  @@map("deshabilitacion_historial")
}

model Rol {
  id      Int       @id @default(autoincrement())
  rol     String
  usuarios Usuario[]
}
model Ticket {
  id Int @id @default(autoincrement())
  titulo String
  descripcion String
  usuarioCreadorId Int
  usuarioCerradorId Int?
  usuarioAfectadoId Int?
  estadoId Int
  tipoTicketId Int
  fecha_creacion DateTime @default(now())
  fecha_cierre DateTime?

  estado TicketEstado @relation(fields: [estadoId], references: [id])
  tipoTicket TipoTicket @relation(fields: [tipoTicketId], references: [id])
  usuarioCerrador Usuario? @relation("TicketCerrado", fields: [usuarioCerradorId], references: [id])
  usuarioCreador Usuario @relation("TicketCreado", fields: [usuarioCreadorId], references: [id])
  usuarioAfectado Usuario? @relation("TicketAfectado", fields: [usuarioAfectadoId], references: [id])
  ticketEquipos TicketEquipo[]
  ticketEvento TicketEvento?
  ticketCierre TicketCierre? 
  reasignaciones TicketReasignacion[]

  @@map("tickets")
  TicketSistema TicketSistema[]
}

model TipoTicket {
  id    Int      @id @default(autoincrement())
  tipo  String
  tickets Ticket[]
  
  @@map("tipo_ticket")
}

model TicketEstado {
  id      Int      @id @default(autoincrement())
  estado  String
  ticket  Ticket[]
  
  @@map("ticket_estado")
}

model TicketCierre {
  id Int @id @default(autoincrement())
  ticketId Int @unique
  usuarioCerradorId Int
  fechaCierre DateTime @default(now())
  condicion String 
  memoFinalizacion String?
  observaciones String?
  tiempoEjecucionMinutos Int?
  
  ticket Ticket @relation(fields: [ticketId], references: [id])
  usuarioCerrador Usuario @relation(fields: [usuarioCerradorId], references: [id])

  @@map("ticket_cierre")
}

model TicketEvento {
  id           Int      @id @default(autoincrement())
  ticketId     Int      @unique
  fecha_evento DateTime
  ubicacion    String
  tipo_evento  String
  analistaId   Int
  analista     Usuario  @relation("EventosAnalista", fields: [analistaId], references: [id])
  ticket       Ticket   @relation(fields: [ticketId], references: [id])
}

model TicketEquipo {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  equipoId   Int
  analistaId Int
  analista   Usuario  @relation("EquiposAnalista", fields: [analistaId], references: [id])
  equipo     Equipos  @relation(fields: [equipoId], references: [id])
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
}

model TipoEquipo {
  id     Int       @id @default(autoincrement())
  nombre String    @unique
  equipos Equipos[]
}

model Equipos {
  id                Int                            @id @default(autoincrement())
  bienNacional      String?
  serial            String?
  observaciones     String?
  tipoEquipoId      Int
  modeloId          Int
  statusId          Int?
  estadoId          Int?
  usuarioId         Int?
  especificacionesId Int?
  
  especificaciones  EspecificacionesAdicionales?   @relation(fields: [especificacionesId], references: [id])
  estado            Estados?                       @relation(fields: [estadoId], references: [id])
  modelo            Modelo                         @relation(fields: [modeloId], references: [id])
  status            Status?                        @relation(fields: [statusId], references: [id])
  tipoEquipo        TipoEquipo                     @relation(fields: [tipoEquipoId], references: [id])
  usuario           Usuario?                       @relation(fields: [usuarioId], references: [id])
  ticketEquipos     TicketEquipo[]
  deshabilitacionesHistorial DesincorporacionHistorialEquipos[]
  reasignacionesHistorial ReasignacionHistorialEquipos[]
}

model DesincorporacionHistorialEquipos {
  id                    Int       @id @default(autoincrement())
  equipoId              Int
  motivo                String
  fechaDeshabilitacion  DateTime  @default(now())
  deshabilitadoPorId    Int
  statusAnteriorId      Int
  statusNuevoId         Int

  equipo                Equipos   @relation(fields: [equipoId], references: [id])
  deshabilitadoPor      Usuario   @relation("DeshabilitacionesEquiposRealizadas", fields: [deshabilitadoPorId], references: [id])
  statusAnterior        Status    @relation("StatusAnterior", fields: [statusAnteriorId], references: [id])
  statusNuevo           Status    @relation("StatusNuevo", fields: [statusNuevoId], references: [id])

  @@map("deshabilitacion_historial_equipos")
}

model EspecificacionesAdicionales {
  id             Int       @id @default(autoincrement())
  memoriaRam     String?
  modulosRam     String?
  capacidadDisco String?
  tipoDisco      String?
  procesador     String?
  equipos        Equipos[]
}

model Marca {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique
  modelos Modelo[]
}

model Modelo {
  id      Int       @id @default(autoincrement())
  nombre  String    @unique
  marcaId Int
  equipos Equipos[]
  marca   Marca     @relation(fields: [marcaId], references: [id])
}

model Status {
  id                        Int                               @id @default(autoincrement())
  estado                    String
  equipos                   Equipos[]
  deshabilitacionesAnteriores DesincorporacionHistorialEquipos[] @relation("StatusAnterior")
  deshabilitacionesNuevas   DesincorporacionHistorialEquipos[] @relation("StatusNuevo")
}

model Estados {
  id     Int       @id @default(autoincrement())
  nombre String
  equipos Equipos[]
}

model Sistema {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique
  estado  String   @default("Activo")
  tickets TicketSistema[]

  @@map("sistemas")
}

model Falla {
  id     Int      @id @default(autoincrement())
  nombre String   @unique
  tickets TicketSistema[]

  @@map("fallas")
}

model TicketSistema {
  id              Int      @id @default(autoincrement())
  ticketId        Int
  sistemaId       Int
  fallaId         Int
  usuarioAfectadoId Int

  ticket          Ticket   @relation(fields: [ticketId], references: [id])
  sistema         Sistema  @relation(fields: [sistemaId], references: [id])
  falla           Falla    @relation(fields: [fallaId], references: [id])
  usuarioAfectado Usuario  @relation(fields: [usuarioAfectadoId], references: [id])

  @@unique([ticketId])
  @@map("ticket_sistemas")
}
model ReasignacionHistorialEquipos {
  id Int @id @default(autoincrement())
  equipoId Int
  usuarioAnteriorId Int?
  usuarioNuevoId Int?
  motivo String?
  reasignadoPorId Int
  fechaReasignacion DateTime @default(now())

  equipo Equipos @relation(fields: [equipoId], references: [id])
  usuarioAnterior Usuario? @relation("ReasignacionEquipoAnterior", fields: [usuarioAnteriorId], references: [id])
  usuarioNuevo Usuario? @relation("ReasignacionEquipoNueva", fields: [usuarioNuevoId], references: [id])
  reasignadoPor Usuario @relation("ReasignacionEquipoRealizada", fields: [reasignadoPorId], references: [id])

  @@map("reasignacion_historial_equipos")
}