generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Direcciones {
  id        Int       @id @default(autoincrement())
  direccion String
  pisoId    Int
  areas     Area[]
  piso      Piso      @relation(fields: [pisoId], references: [id])
  usuarios  Usuario[]
}

model Area {
  id          Int       @id @default(autoincrement())
  nombre      String
  direccionId Int
  direccion   Direcciones @relation(fields: [direccionId], references: [id])
  usuarios    Usuario[]
}

model Piso {
  id          Int           @id @default(autoincrement())
  piso        String
  direcciones Direcciones[]
}

model Usuario {
  id          Int                         @id @default(autoincrement())
  cedula      String?
  nombre      String
  apellido    String?
  email       String?                     @unique
  rolId       Int
  direccionId Int
  areaId      Int?
  password    String?
  estado      String                      @default("Activo")
  tipoAnalistaId Int?
  
  equipos                           Equipos[]
  ticketCerrado                     Ticket[]                     @relation("TicketCerrado")
  ticketCreado                      Ticket[]                     @relation("TicketCreado")
  ticketAnalistaEquipo              TicketEquipo[]               @relation("EquiposAnalista")
  ticketAnalista                    TicketEvento[]               @relation("EventosAnalista")
  area                              Area?                        @relation(fields: [areaId], references: [id])
  direccion                         Direcciones                  @relation(fields: [direccionId], references: [id])
  rol                               Rol                          @relation(fields: [rolId], references: [id])
  tipoAnalista                      TipoAnalista?                @relation(fields: [tipoAnalistaId], references: [id])
  
  deshabilitacionesRealizadas       DeshabilitacionHistorial[]   @relation("DeshabilitacionesRealizadas")
  deshabilitacionesRecibidas        DeshabilitacionHistorial[]   @relation("DeshabilitacionesRecibidas")
  deshabilitacionesEquiposRealizadas DesincorporacionHistorialEquipos[] @relation("DeshabilitacionesEquiposRealizadas")
  ticketAfectado                      Ticket[]                     @relation("TicketAfectado")

  @@map("usuarios")
}

model TipoAnalista {
  id    Int       @id @default(autoincrement())
  tipo  String
  usuarios Usuario[]
  
  @@map("tipo_analista")
}

model DeshabilitacionHistorial {
  id                    Int       @id @default(autoincrement())
  usuarioId             Int
  motivo                String
  fechaDeshabilitacion  DateTime  @default(now())
  deshabilitadoPorId    Int
  usuario               Usuario   @relation("DeshabilitacionesRecibidas", fields: [usuarioId], references: [id])
  deshabilitadoPor      Usuario   @relation("DeshabilitacionesRealizadas", fields: [deshabilitadoPorId], references: [id])

  @@map("deshabilitacion_historial")
}

model Rol {
  id      Int       @id @default(autoincrement())
  rol     String
  usuarios Usuario[]
}
model Ticket {
  id               Int            @id @default(autoincrement())
  titulo           String
  descripcion      String
  usuarioCreadorId Int
  usuarioCerradorId Int?
  usuarioAfectadoId Int?        
  estadoId         Int
  tipoTicketId     Int
  fecha_creacion   DateTime       @default(now())
  fecha_cierre     DateTime?
  
  // Relaciones
  estado           TicketEstado   @relation(fields: [estadoId], references: [id])
  tipoTicket       TipoTicket     @relation(fields: [tipoTicketId], references: [id])
  usuarioCerrador  Usuario?       @relation("TicketCerrado", fields: [usuarioCerradorId], references: [id])
  usuarioCreador   Usuario        @relation("TicketCreado", fields: [usuarioCreadorId], references: [id])
  usuarioAfectado  Usuario?       @relation("TicketAfectado", fields: [usuarioAfectadoId], references: [id]) 
  ticketEquipos    TicketEquipo[]
  ticketEvento     TicketEvento?

  @@map("tickets")
}

model TipoTicket {
  id    Int      @id @default(autoincrement())
  tipo  String
  tickets Ticket[]
  
  @@map("tipo_ticket")
}

model TicketEstado {
  id      Int      @id @default(autoincrement())
  estado  String
  ticket  Ticket[]
  
  @@map("ticket_estado")
}

model TicketEvento {
  id           Int      @id @default(autoincrement())
  ticketId     Int      @unique
  fecha_evento DateTime
  ubicacion    String
  tipo_evento  String
  analistaId   Int
  analista     Usuario  @relation("EventosAnalista", fields: [analistaId], references: [id])
  ticket       Ticket   @relation(fields: [ticketId], references: [id])
}

model TicketEquipo {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  equipoId   Int
  analistaId Int
  analista   Usuario  @relation("EquiposAnalista", fields: [analistaId], references: [id])
  equipo     Equipos  @relation(fields: [equipoId], references: [id])
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
}

model TipoEquipo {
  id     Int       @id @default(autoincrement())
  nombre String    @unique
  equipos Equipos[]
}

model Equipos {
  id                Int                            @id @default(autoincrement())
  bienNacional      String?
  serial            String?
  observaciones     String?
  tipoEquipoId      Int
  modeloId          Int
  statusId          Int?
  estadoId          Int?
  usuarioId         Int?
  especificacionesId Int?
  
  // Relaciones
  especificaciones  EspecificacionesAdicionales?   @relation(fields: [especificacionesId], references: [id])
  estado            Estados?                       @relation(fields: [estadoId], references: [id])
  modelo            Modelo                         @relation(fields: [modeloId], references: [id])
  status            Status?                        @relation(fields: [statusId], references: [id])
  tipoEquipo        TipoEquipo                     @relation(fields: [tipoEquipoId], references: [id])
  usuario           Usuario?                       @relation(fields: [usuarioId], references: [id])
  ticketEquipos     TicketEquipo[]
  deshabilitacionesHistorial DesincorporacionHistorialEquipos[]
}

model DesincorporacionHistorialEquipos {
  id                    Int       @id @default(autoincrement())
  equipoId              Int
  motivo                String
  fechaDeshabilitacion  DateTime  @default(now())
  deshabilitadoPorId    Int
  statusAnteriorId      Int
  statusNuevoId         Int

  equipo                Equipos   @relation(fields: [equipoId], references: [id])
  deshabilitadoPor      Usuario   @relation("DeshabilitacionesEquiposRealizadas", fields: [deshabilitadoPorId], references: [id])
  statusAnterior        Status    @relation("StatusAnterior", fields: [statusAnteriorId], references: [id])
  statusNuevo           Status    @relation("StatusNuevo", fields: [statusNuevoId], references: [id])

  @@map("deshabilitacion_historial_equipos")
}

model EspecificacionesAdicionales {
  id             Int       @id @default(autoincrement())
  memoriaRam     String?
  modulosRam     String?
  capacidadDisco String?
  tipoDisco      String?
  procesador     String?
  equipos        Equipos[]
}

model Marca {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique
  modelos Modelo[]
}

model Modelo {
  id      Int       @id @default(autoincrement())
  nombre  String    @unique
  marcaId Int
  equipos Equipos[]
  marca   Marca     @relation(fields: [marcaId], references: [id])
}

model Status {
  id                        Int                               @id @default(autoincrement())
  estado                    String
  equipos                   Equipos[]
  deshabilitacionesAnteriores DesincorporacionHistorialEquipos[] @relation("StatusAnterior")
  deshabilitacionesNuevas   DesincorporacionHistorialEquipos[] @relation("StatusNuevo")
}

model Estados {
  id     Int       @id @default(autoincrement())
  nombre String
  equipos Equipos[]
}